# Copy to .env and fill in. .env is git-ignored; this example file is committed.

# Required from Milestone 5 (LLM brief). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Raises openFDA limit from 1,000 to 120,000 requests/day.
# Free at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
